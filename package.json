{
  "name": "@zerobounce/zero-bounce-sdk",
  "version": "3.1.0",
  "description": "Official ZeroBounce JavaScript SDK: email validation, AI scoring, bulk files, email finder and domain search",
  "keywords": [
    "zerobounce",
    "email-validation",
    "email-verification",
    "email-finder",
    "domain-search",
    "sdk",
    "javascript",
    "typescript"
  ],
  "main": "dist/zeroBounceSDK.js",
  "types": "zeroBounceSDK.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./zeroBounceSDK.d.mts",
        "default": "./zeroBounceSDK.mjs"
      },
      "require": {
        "types": "./zeroBounceSDK.d.ts",
        "default": "./dist/zeroBounceSDK.js"
      },
      "default": {
        "types": "./zeroBounceSDK.d.ts",
        "default": "./dist/zeroBounceSDK.js"
      }
    }
  },
  "files": [
    "dist",
    "zeroBounceSDK.d.ts",
    "zeroBounceSDK.d.mts",
    "zeroBounceSDK.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest && npm run test:types",
    "test:unit": "jest",
    "test:smoke": "node tests/smoke-dist.js",
    "test:coverage": "jest --coverage",
    "build": "webpack --mode=production",
    "prepublishOnly": "npm run build",
    "dts-check": "tsc --noEmit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:real-api": "node tests/real-api-prod.mjs",
    "test:live": "node tests/live-api.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerobounce/zero-bounce-javascript.git"
  },
  "author": "ZeroBounce",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zerobounce/zero-bounce-javascript/issues"
  },
  "homepage": "https://github.com/zerobounce/zero-bounce-javascript#readme",
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.9",
    "minimatch": "^11.0.1",
    "test-exclude": {
      "minimatch": "^3.0.4"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "webpack": "^5.78.0",
    "webpack-cli": "^7.0.2",
    "whatwg-fetch": "^3.6.18",
    "typescript": "^7.0.2"
  }
}
