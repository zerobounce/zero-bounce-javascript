// `npm run dts-check` type-checks the shipped declaration files with this config.
// skipLibCheck must stay false: it skips every .d.ts file, including these two.
// `types` is empty so the check cannot lean on @types/node, which a browser
// consumer may not have installed.
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "files": ["zeroBounceSDK.d.ts", "zeroBounceSDK.d.mts"]
}
